name = aves-eagle
bird = eagle

# AvesEagle: the hummingbird tensegrity shoulder carrying a three-linkage avian
# wing (humerus / ulna / manus) instead of the flat plate, stroking side to side
# the way the hummingbird plate wing does. Bone proportions and
# the fold topology follow the Passeri wing-skeleton figure on Wikimedia Commons
# (Bird wing skeleton. Passeri.svg): humerus, then the ulna+radius forearm, then
# the carpometacarpus + phalanges of the manus, with the primaries raked off the
# manus and the secondaries off the ulna.
#
# The shoulder is unchanged tensegrity: the humerus is a rigid child of the
# mobile strut, so the tendon network IS its glenohumeral joint, exactly as the
# plate wing is mounted. Only the elbow and wrist are ordinary hinges.
#
# The stroke is the hummingbird's, unchanged: the hovering design's disk pitch
# 20 deg, 12 deg crank phase lag and 23/26 mm throws, which sweep the wing through
# a wide arc in a near-horizontal stroke plane. Measured with this wing on it:
# 118 deg of fore-aft sweep against only 38 deg of elevation.
#
# `bones.mount` is what orients the eagle wing on that sweep, and it is
# load-bearing. The strut's motion is a compound whirl, and only a narrow band of
# mount orientations turns it into a clean lateral sweep with the span staying
# near level; most of SO(3) either points the wing at the sky (where azimuth is
# meaningless and the search will happily collect 290 deg of wrap) or trades the
# sweep for an up-and-down flap. Found by recording the strut's rotation over a
# cycle and searching, gated on the span staying horizontal and lateral.
#
# What the shoulder will NOT do on its own is hold the wing plane flat — the whirl
# rolls the wing ~41 deg peak-to-peak, turning it edge-on twice a beat.
# runtime/eagle_drive.py measures that roll per scene and cancels it with the
# humerus twist servo, which is also what carries the deliberate pronation.
# Retune anything above and the correction re-measures itself.

world:
    # Timestep is set by tendon stiffness, not drive rate, so the hummingbird's
    # 0.13 ms at scale 0.4 carries over unchanged even though the eagle flaps 4x
    # slower. Measured cliff: stable to 0.20 ms, diverges at 0.22 and above,
    # within the first 10-14 ms and not rescuable by a gentler drive ramp. So
    # 0.13 buys 1.55x, not a comfortable margin — and the stroke is identical at
    # 0.05 ms, so the resolution buys margin only.
    gravity    = [0, 0, -9.81]
    timestep   = 0.13 ms
    integrator = Euler
    scale      = 0.4
    meshdir    = assets

archetype strut C:
    shape    = arc
    radius   = 48.23931363603964 mm
    stations = [5.8, 68.7, 111.3, 174.2] deg
    width    = 6.0 mm
    arc_rod  = { radius: 4.0 mm, mass: 10 g }
    rung_rod = { radius: 2.0 mm, mass: 5 g }
    symmetry sigma = reflect(stations: 1<->4, 2<->3 ; faces: A<->B)

strut F = C { role: fixed,  plane: YZ }
strut M = C { role: mobile, plane: XZ }

arrange M relative_to F:
    gap            = 30 mm
    angle          = 0 deg
    mobile_dx      = 5 mm
    inplane_offset = 4.649 mm

placement:
    mount_height   = 258 mm
    lateral_offset = 31 mm

tendons:
    defaults { stiffness: 200 N/m, damping: 0.5, pretension: 0.827, width: 0.75 mm }
    length = derived
    generators under sigma:
        M[1A] -- F[4B]
        M[1A] -- F[3B]
        M[1B] -- F[2B]
        M[1B] -- F[1B]
        M[2A] -- F[4B]
        M[2B] -- F[1B]

motors:
    disk { radius: 18.0 mm, crank_throw: 23 mm, tilt: 0.0 rad, pitch: 20 deg, kv: 1.0, ctrl: [-120, 120],
           solref: [0.02857142857142857, 1.0],
           outboard: 30.625 mm,
           foot_outset: 0.25 mm,
           disk_dx: 0 mm, disk_dy: -20 mm }
    drive M[1] and M[4]
    attach_along_edge = 0.0 rad
    attach_radius = 1.0
    # Straight from the hovering design: this is what makes the stroke a
    # hummingbird's horizontal sweep rather than an up-and-down flap.
    crank_phase_lag = 12 deg
    crank_throw_t4 = 26 mm
    tendon_rest_length = 53 mm
    tendon_stiffness  = 1000 N/m
    tendon_damping    = 1.0
    control = eagle_control.tg
    motor_direction = 1

wing on M.midpoint:
    bones:
        # Humerus frame on the mobile strut (intrinsic x-y-z Euler). See header.
        # The third angle is a roll about the span: 89 deg stands the wing on edge so
        # it paddles the sweep. At ~0 the wing lies flat and slices through it.
        mount       = [-11.41, 8.07, 89.00] deg
        # Ratios from the reference plate, humerus : ulna : manus ~ 1 : 1.12 : 0.98.
        humerus     = 50 mm
        ulna        = 55 mm
        manus       = 49 mm
        primary     = 95 mm
        chord       = 70 mm
        mass        = 0.12 g
        # The wing spreads across the sweep and tucks a little through each
        # reversal, so the range only has to cover a shallow flex. A hummingbird's
        # wing is near-rigid: the drive uses ~0.35 of this, and past ~0.5 the wing
        # visibly shortens at each end instead of rowing.
        elbow_range = [-70, 4] deg
        wrist_range = [-65, 4] deg
        # Wide: the twist servo carries both the roll cancellation (~41 deg of it)
        # and the wing flip at each end of the stroke.
        twist_range = [-70, 70] deg
        # Stiff: a critically damped servo at kp 0.1 lagged the 2.5 Hz stroke by
        # ~25 deg, which showed up as the wing failing to level in time.
        servo       = 6.0
        damping     = 2e-4
        armature    = 2e-5
    wrist:
        # A second tensegrity joint, same six sigma generators as the shoulder,
        # scaled down. The hand leaves the kinematic chain to get it: a free joint
        # has to be top level in MuJoCo, so the distal strut is a worldbody child
        # and nothing but these tendons joins the manus to the forearm.
        scale       = 0.42
        # Shallower arc than the shoulder's 5.8..174.2: a wrist wants less range
        # and more stiffness out of the wing plane.
        stations    = [28, 74, 106, 152] deg
        # Centre-to-centre along the span: the ulna's strut sits on the forearm's
        # tip and the manus' one this far outboard, where the hand's bone begins.
        # So this is the joint's whole length, and the knob for how far apart the
        # two bones sit. At 14 mm they read as two separate cages, not one joint.
        gap         = 8 mm
        width       = 2.6 mm
        # Both numbers are set by the stability cliff, not by feel: the wrist rods
        # are ~1/5 the shoulder's, and below 2 g declared (128 mg after the
        # scale^3 mass law) the net rings past the 0.13 ms timestep and diverges
        # no matter how soft the tendons are. Above it, stiffness just buys
        # tightness -- gap wander over a stroke goes 2.6 mm at 400 N/m, 1.6 at
        # 800, 0.9 at 1600, 0.5 at 3000. 800 is where tightness stops being free:
        # the whole rig still holds to 0.20 ms there, same cliff as without the
        # wrist, and 1600 pulls it in to 0.16.
        stiffness   = 800 N/m
        damping     = 0.6
        pretension  = 0.88
        tendon_width = 0.4 mm
        arc_rod     = { radius: 1.3 mm, mass: 2.0 g }
        rung_rod    = { radius: 0.9 mm, mass: 1.0 g }
    feathers:
        # Each vane is a short chain of sprung links rather than a geom welded to
        # the bone, so the shaft CURVES under load the way a feather does. Rest
        # angle is the welded pose; the springs are the elastic lining a real
        # feather is rooted in, and the axis is the one a feather gives on — out
        # of the wing plane, not sweeping in it.
        #
        # `segments` is what makes the fan move feather by feather. One link is a
        # gate hinged at the quill: the tip only moves if the root angle is large,
        # and since every vane in a fan sees the same acceleration they all swing
        # together. Softening a gate does not fix that -- it only makes a floppier
        # gate. Measured on the primaries, adjacent |difference| and the spread
        # across the fan at one instant:
        #
        #   1 seg  k=3e-4   tip 22 deg   adjacent 0.34   spread  2.4
        #   1 seg  k=8e-5   tip 58       adjacent 1.40   spread  9.4   (on the stops)
        #   1 seg  k=2e-5   tip 86       adjacent 1.92   spread 13.0   (on the stops)
        #   3 seg  k=1e-4   tip 47       adjacent 1.96   spread  9.6
        #   3 seg  k=7e-5   tip 72       adjacent 3.52   spread 20.7
        #   3 seg  k=5e-5   tip 103      adjacent 8.00   spread 41.1   (on the stops)
        #
        # A gate saturates near 2 deg of neighbour-to-neighbour difference however
        # soft it gets. A chain has bending modes of its own, and adjacent vanes
        # differ enough in length to run them at different phases, so the fan
        # ripples instead of swinging as a slab.
        segments  = 3
        # The WHOLE vane's bending stiffness, not one joint's: a uniform beam of
        # stiffness EI cut into N links wants N*EI/L at each node, and that is
        # what the emitter hands out. So `segments` refines the shape without
        # changing how floppy the feather is.
        #
        # 7e-5 puts the outer primary's tip through 72 deg over a cycle with each
        # joint at ~44, and holds ~21 deg of spread across the eight primaries --
        # visibly individual, still a wing. Past ~6e-5 the vanes rake through each
        # other (they do not collide, so nothing stops them) and the hand reads as
        # a feather duster.
        stiffness = 7.0e-5
        # Damping ratio, applied per joint as 2*zeta*sqrt(k*I) against that link's
        # own inertia. Underdamped: a feather springs back, it does not creep back.
        zeta      = 0.35
        # Armature as a FRACTION of the link's own inertia. It has to be a
        # fraction: a link's inertia falls as 1/segments^3, so any absolute number
        # stops meaning anything the moment the segment count moves. The
        # shoulder-joint class default is absolute, 0.005, and orders above a
        # link's inertia -- the emitter overrides it, and the frictionloss, or the
        # vane is welded solid with the DOFs still there to pay for.
        armature  = 0.05
        # Per joint, so the vane's whole travel is three times this. A backstop,
        # not a working range: peak demand is 44 deg. Stops on a milligram link
        # are worth never reaching.
        range     = [-50, 50] deg
    cables:
        # The wing as a tensegrity: one cable per bone, each running in to a pin
        # on a crank disk rather than to another bone. The pin is off the disk's
        # hinge axis, so the motors drive the wing's shape directly.
        humerus_frac = 0.55
        ulna_frac    = 0.50
        manus_frac   = 0.45
        offset       = 0 mm
        # Retinacula. Every cable rides in over a post at the distal end of each
        # bone inboard of its own — the hand's runs wrist, forearm, humerus, body
        # — instead of hanging straight across open air to the disk. Signed along
        # the chord (+x = trailing edge, so -x is cranial), and opposite because
        # the elbow and the wrist counter-rotate: this is the avian Z-fold. At 0
        # the cable passes through the joint centre, where it has no moment arm
        # and stops folding that joint at all.
        humerus_guide = -6 mm
        ulna_guide    = 6 mm
        disks        = [t1, t4, t4]
        pin_radius   = 12 mm
        pin_phase    = 180 deg
        stiffness    = 120 N/m
        damping      = 0.4
        width        = 0.5 mm
        # Rest-length fractions of each cable's compiled length, in bone order.
        extend       = [1.00, 1.00, 1.00]
        contract     = [0.92, 0.92, 0.92]
