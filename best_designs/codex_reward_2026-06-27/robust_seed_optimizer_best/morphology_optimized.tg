name = bi-shoulder

world:
    gravity    = [0, 0, -9.81]
    # Stable timestep scales as scale^1.5 (spring-mass freq ~1/scale^1.5 as rod
    # mass drops with scale^3). 0.50 ms holds at scale 1.0; at scale 0.4 that needs
    # 0.50 * 0.4^1.5 ~ 0.13 ms or the full-size wing's aero diverges the rig.
    timestep   = 0.13 ms
    integrator = implicitfast
    scale      = 0.4
    meshdir    = assets

archetype strut C:
    shape    = arc
    radius   = 48.23931363603964 mm
    stations = [5.8, 68.7, 111.3, 174.2] deg
    width    = 6.0 mm
    arc_rod  = { radius: 4.0 mm, mass: 10 g }
    rung_rod = { radius: 2.0 mm, mass: 5 g }
    symmetry sigma = reflect(stations: 1<->4, 2<->3 ; faces: A<->B)

strut F = C { role: fixed,  plane: YZ }
strut M = C { role: mobile, plane: XZ }

arrange M relative_to F:
    gap            = 30 mm
    angle          = 0 deg
    mobile_dx      = 5 mm
    inplane_offset = 4.649 mm

placement:
    mount_height   = 258 mm
    lateral_offset = 31 mm

tendons:
    defaults { stiffness: 200 N/m, damping: 0.5, pretension: 1.0, width: 0.75 mm }
    length = derived
    generators under sigma:
        M[1A] -- F[4B]
        M[1A] -- F[3B]
        M[1B] -- F[2B]
        M[1B] -- F[1B]
        M[2A] -- F[4B]
        M[2B] -- F[1B]

    overrides:
        M[1A] -- F[4B] { stiffness: 197.7, pretension: 1.024 }
        M[4B] -- F[1A] { stiffness: 200.2, pretension: 0.9755 }
        M[1A] -- F[3B] { stiffness: 221.1, pretension: 0.8944 }
        M[4B] -- F[2A] { stiffness: 200.7, pretension: 1.033 }
        M[1B] -- F[2B] { stiffness: 196.4, pretension: 0.8787 }
        M[4A] -- F[3A] { stiffness: 205.8, pretension: 1.123 }
        M[1B] -- F[1B] { stiffness: 201.5, pretension: 1.015 }
        M[4A] -- F[4A] { stiffness: 221.1, pretension: 0.9305 }
        M[2A] -- F[4B] { stiffness: 215.4, pretension: 0.9849 }
        M[3B] -- F[1A] { stiffness: 183.6, pretension: 0.9796 }
        M[2B] -- F[1B] { stiffness: 198.2, pretension: 0.9926 }
        M[3A] -- F[4A] { stiffness: 187, pretension: 0.9348 }

motors:
    disk { radius: 18.0 mm, crank_throw: 23 mm, tilt: 0.0 rad, pitch: 50 deg, kv: 0.25, ctrl: [-120, 120],
           solref: [0.02857142857142857, 1.0],
           outboard: 30.625 mm,
           foot_outset: 0.25 mm,
           disk_dx: 0 mm, disk_dy: -20 mm }
    drive M[1] and M[4]
    attach_along_edge = 0.0 rad
    attach_radius = 1.0
    drive_phase_offset = 180 deg
    tendon_pretension = 0.807345
    tendon_stiffness  = 614.409 N/m
    tendon_damping    = 1.0
    control = /workspace/DiffSimAvesBot-codex-reward/opt/codex_runs/robust_seed/control_optimized.tg
    motor_direction = 1

wing on M.midpoint:
    rod_length = 18.0 mm
    mount_arm  = 55.0 mm
    mesh       = wing.stl
    pitch:
        upstroke_pitch      = 0.08584924 rad
        downstroke_pitch    = 0.083691746 rad
        upstroke_stiffness  = 0.029021652
        downstroke_stiffness = 0.030348318
        damping    = 1e-5
        initial    = 0.0 rad
        range      = [-0.7, 0.7] rad
        armature   = 1e-6
    aero:
        blades      = 4
        force_scale = 1e6
        body_torque = off
        cop         = derived
