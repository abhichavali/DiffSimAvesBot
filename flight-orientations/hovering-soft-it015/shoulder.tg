name = bi-shoulder

world:
    gravity    = [0, 0, -9.81]
    # Stable timestep scales as scale^1.5 (spring-mass freq ~1/scale^1.5 as rod
    # mass drops with scale^3). 0.50 ms holds at scale 1.0; at scale 0.4 that needs
    # 0.50 * 0.4^1.5 ~ 0.13 ms or the full-size wing's aero diverges the rig.
    timestep   = 0.13 ms
    integrator = Euler
    scale      = 0.4
    meshdir    = assets

archetype strut C:
    shape    = arc
    radius   = 48.23931363603964 mm
    stations = [5.8, 68.7, 111.3, 174.2] deg
    width    = 6.0 mm
    arc_rod  = { radius: 4.0 mm, mass: 10 g }
    rung_rod = { radius: 2.0 mm, mass: 5 g }
    symmetry sigma = reflect(stations: 1<->4, 2<->3 ; faces: A<->B)

strut F = C { role: fixed,  plane: YZ }
strut M = C { role: mobile, plane: XZ }

arrange M relative_to F:
    gap            = 30 mm
    angle          = 0 deg
    mobile_dx      = 5 mm
    inplane_offset = 4.649 mm

placement:
    mount_height   = 258 mm
    lateral_offset = 31 mm

tendons:
    defaults { stiffness: 200 N/m, damping: 0.5, pretension: 0.827, width: 0.75 mm }
    length = derived
    generators under sigma:
        M[1A] -- F[4B]
        M[1A] -- F[3B]
        M[1B] -- F[2B]
        M[1B] -- F[1B]
        M[2A] -- F[4B]
        M[2B] -- F[1B]
    overrides:
        L_t1_to_t1_2 { stiffness: 183.7678 N/m, pretension: 0.745860 }
        L_t4_2_to_t1 { stiffness: 164.7800 N/m, pretension: 0.653052 }
        L_t1_to_t2_2 { stiffness: 251.1539 N/m, pretension: 0.651946 }
        L_t4_2_to_t2 { stiffness: 289.3975 N/m, pretension: 0.809892 }
        L_t1_2_to_t3_2 { stiffness: 143.8795 N/m, pretension: 0.686166 }
        L_t4_to_t3 { stiffness: 124.5668 N/m, pretension: 1.012149 }
        L_t1_2_to_t4_2 { stiffness: 208.8495 N/m, pretension: 0.780499 }
        L_t4_to_t4 { stiffness: 120.1046 N/m, pretension: 0.783411 }
        L_t2_to_t1_2 { stiffness: 113.6320 N/m, pretension: 0.794390 }
        L_t3_2_to_t1 { stiffness: 311.5830 N/m, pretension: 0.675876 }
        L_t2_2_to_t4_2 { stiffness: 126.6183 N/m, pretension: 0.950126 }
        L_t3_to_t4 { stiffness: 139.4878 N/m, pretension: 1.199361 }
        R_t1_to_t1_2 { stiffness: 342.6353 N/m, pretension: 0.778945 }
        R_t4_2_to_t1 { stiffness: 165.1905 N/m, pretension: 0.674135 }
        R_t1_to_t2_2 { stiffness: 115.1274 N/m, pretension: 1.004636 }
        R_t4_2_to_t2 { stiffness: 293.4571 N/m, pretension: 0.698832 }
        R_t1_2_to_t3_2 { stiffness: 138.6920 N/m, pretension: 0.651982 }
        R_t4_to_t3 { stiffness: 156.3968 N/m, pretension: 1.032974 }
        R_t1_2_to_t4_2 { stiffness: 176.2796 N/m, pretension: 1.049243 }
        R_t4_to_t4 { stiffness: 132.1185 N/m, pretension: 0.641801 }
        R_t2_to_t1_2 { stiffness: 282.3049 N/m, pretension: 0.769683 }
        R_t3_2_to_t1 { stiffness: 163.9554 N/m, pretension: 0.846950 }
        R_t2_2_to_t4_2 { stiffness: 250.5894 N/m, pretension: 0.952311 }
        R_t3_to_t4 { stiffness: 337.6563 N/m, pretension: 1.179797 }

motors:
    # HOVERING: mild forward inclination of the stroke plane (pitch 20 deg) with a
    # small down/up asymmetry from a 6 deg crank phase lag and a slightly longer t4
    # throw (25 vs 22 mm).
    disk { radius: 18.0 mm, crank_throw: 22 mm, tilt: 0.0 rad, pitch: 20 deg, kv: 1.0, ctrl: [-120, 120],
           solref: [0.02857142857142857, 1.0],
           outboard: 30.625 mm,
           foot_outset: 0.25 mm,
           disk_dx: 0 mm, disk_dy: -20 mm }
    drive M[1] and M[4]
    attach_along_edge = 0.0 rad
    attach_radius = 1.0
    crank_phase_lag = 6 deg
    crank_throw_t4 = 25 mm
    tendon_rest_length = 54.462 mm
    tendon_stiffness  = 999.00 N/m
    tendon_damping    = 1.0
    control = control.tg
    motor_direction = 1

wing on M.midpoint:
    rod_length = 18.0 mm
    mount_arm  = 55.0 mm
    mesh       = wing.stl
    pitch:
        free_angle = 10 deg
        stiffness  = 0.05
        damping    = 1e-5
        initial    = 0.0 rad
        range      = [-0.7, 0.7] rad
        armature   = 1e-6
    aero:
        blades      = 4
        force_scale = 1e6
        body_torque = off
        cop         = derived
