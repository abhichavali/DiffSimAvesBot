name = bi-shoulder
bird = hummer

world:
    gravity    = [0, 0, -9.81]
    # Stable timestep scales as scale^1.5 (spring-mass freq ~1/scale^1.5 as rod
    # mass drops with scale^3). 0.50 ms holds at scale 1.0; at scale 0.4 that needs
    # 0.50 * 0.4^1.5 ~ 0.13 ms or the full-size wing's aero diverges the rig.
    # The low-slack motor-tendon rests (below) over-constrain the foot at 0.13 ms
    # (the stroke chokes); 0.06 ms restores a clean flap and halves t1 tendon slack.
    timestep   = 0.06 ms
    integrator = implicitfast
    scale      = 0.4
    meshdir    = assets

archetype strut C:
    shape    = arc
    radius   = 48.23931363603964 mm
    stations = [5.8, 68.7, 111.3, 174.2] deg
    width    = 6.0 mm
    arc_rod  = { radius: 4.0 mm, mass: 10 g }
    rung_rod = { radius: 2.0 mm, mass: 5 g }
    symmetry sigma = reflect(stations: 1<->4, 2<->3 ; faces: A<->B)

strut F = C { role: fixed,  plane: YZ }
strut M = C { role: mobile, plane: XZ }

arrange M relative_to F:
    gap            = 30 mm
    angle          = 0 deg
    mobile_dx      = 5 mm
    inplane_offset = 4.649 mm

placement:
    mount_height   = 258 mm
    lateral_offset = 31 mm

tendons:
    defaults { stiffness: 200 N/m, damping: 0.5, pretension: 0.827, width: 0.75 mm }
    length = derived
    generators under sigma:
        M[1A] -- F[4B]
        M[1A] -- F[3B]
        M[1B] -- F[2B]
        M[1B] -- F[1B]
        M[2A] -- F[4B]
        M[2B] -- F[1B]

motors:
    # FORWARD FLIGHT: strong forward inclination of the stroke plane (pitch 50 deg)
    # with a pronounced down/up asymmetry from a 28 deg crank phase lag and a longer
    # t4 throw (30 vs 23 mm).
    disk { radius: 18.0 mm, crank_throw: 25 mm, tilt: 0.0 rad, pitch: 50 deg, kv: 1.0, ctrl: [-120, 120],
           solref: [0.02857142857142857, 1.0],
           outboard: 30.625 mm,
           foot_outset: 0.25 mm,
           disk_dx: 0 mm, disk_dy: -23 mm }
    drive M[1] and M[4]
    attach_along_edge = 0.0 rad
    attach_radius = 1.0
    crank_phase_lag = 28 deg
    # Crank throws near the 27 mm size cap for lift: t1 = 25 mm, t4 = 27 mm. Keeping
    # them different preserves a down/up throw asymmetry on top of the crank_phase_lag.
    crank_throw_t4 = 27 mm
    # The two disks aren't symmetric about the tensegrity, so the t1 and t4 motor
    # tendons sweep different length bands. A single 53 mm rest left t1 slack ~32% of
    # the cycle while t4 never slackened (and over-stretched). Per-foot rests sit just
    # below each tendon's dynamic min so both stay taut: t4 holds 0% slack, t1 ~19%.
    tendon_rest_length_t1 = 42 mm
    tendon_rest_length_t4 = 55 mm
    tendon_rest_length = 53 mm
    tendon_stiffness  = 1000 N/m
    tendon_damping    = 1.0
    control = control.tg
    motor_direction = 1

wing on M.midpoint:
    rod_length = 18.0 mm
    mount_arm  = 55.0 mm
    mesh       = wing.stl
    pitch:
        free_angle = 10 deg
        stiffness  = 0.05
        damping    = 1e-5
        initial    = 0.0 rad
        range      = [-0.7, 0.7] rad
        armature   = 1e-6
    aero:
        blades      = 4
        force_scale = 1e6
        body_torque = off
        cop         = derived
