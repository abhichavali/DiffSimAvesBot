name = bi-shoulder

world:
    gravity    = [0, 0, -9.81]
    # Stable timestep scales as scale^1.5 (spring-mass freq ~1/scale^1.5 as rod
    # mass drops with scale^3). 0.50 ms holds at scale 1.0; at scale 0.4 that needs
    # 0.50 * 0.4^1.5 ~ 0.13 ms or the full-size wing's aero diverges the rig.
    timestep   = 0.13 ms
    integrator = Euler
    scale      = 0.4
    meshdir    = assets

archetype strut C:
    shape    = arc
    radius   = 48.23931363603964 mm
    stations = [5.8, 68.7, 111.3, 174.2] deg
    width    = 6.0 mm
    arc_rod  = { radius: 4.0 mm, mass: 10 g }
    rung_rod = { radius: 2.0 mm, mass: 5 g }
    symmetry sigma = reflect(stations: 1<->4, 2<->3 ; faces: A<->B)

strut F = C { role: fixed,  plane: YZ }
strut M = C { role: mobile, plane: XZ }

arrange M relative_to F:
    gap            = 30 mm
    angle          = 0 deg
    mobile_dx      = 5 mm
    inplane_offset = 4.649 mm

placement:
    mount_height   = 258 mm
    lateral_offset = 31 mm

tendons:
    defaults { stiffness: 200 N/m, damping: 0.5, pretension: 0.827, width: 0.75 mm }
    length = derived
    generators under sigma:
        M[1A] -- F[4B]
        M[1A] -- F[3B]
        M[1B] -- F[2B]
        M[1B] -- F[1B]
        M[2A] -- F[4B]
        M[2B] -- F[1B]
    overrides:
        L_t1_to_t1_2 { stiffness: 184.6783 N/m, pretension: 0.742292 }
        L_t4_2_to_t1 { stiffness: 164.0205 N/m, pretension: 0.655611 }
        L_t1_to_t2_2 { stiffness: 250.0435 N/m, pretension: 0.651563 }
        L_t4_2_to_t2 { stiffness: 289.9894 N/m, pretension: 0.806348 }
        L_t1_2_to_t3_2 { stiffness: 143.3405 N/m, pretension: 0.689350 }
        L_t4_to_t3 { stiffness: 124.5614 N/m, pretension: 1.008381 }
        L_t1_2_to_t4_2 { stiffness: 208.3308 N/m, pretension: 0.782886 }
        L_t4_to_t4 { stiffness: 119.6529 N/m, pretension: 0.785981 }
        L_t2_to_t1_2 { stiffness: 113.9695 N/m, pretension: 0.796945 }
        L_t3_2_to_t1 { stiffness: 312.7536 N/m, pretension: 0.673484 }
        L_t2_2_to_t4_2 { stiffness: 127.0523 N/m, pretension: 0.946397 }
        L_t3_to_t4 { stiffness: 140.0703 N/m, pretension: 1.204846 }
        R_t1_to_t1_2 { stiffness: 341.2446 N/m, pretension: 0.782507 }
        R_t4_2_to_t1 { stiffness: 166.0354 N/m, pretension: 0.670786 }
        R_t1_to_t2_2 { stiffness: 115.6940 N/m, pretension: 1.005704 }
        R_t4_2_to_t2 { stiffness: 292.0775 N/m, pretension: 0.702192 }
        R_t1_2_to_t3_2 { stiffness: 139.3465 N/m, pretension: 0.650486 }
        R_t4_to_t3 { stiffness: 155.6810 N/m, pretension: 1.037793 }
        R_t1_2_to_t4_2 { stiffness: 177.1607 N/m, pretension: 1.054410 }
        R_t4_to_t4 { stiffness: 131.6219 N/m, pretension: 0.638531 }
        R_t2_to_t1_2 { stiffness: 280.8965 N/m, pretension: 0.767387 }
        R_t3_2_to_t1 { stiffness: 164.7933 N/m, pretension: 0.848817 }
        R_t2_2_to_t4_2 { stiffness: 249.3433 N/m, pretension: 0.955885 }
        R_t3_to_t4 { stiffness: 339.3587 N/m, pretension: 1.183939 }

motors:
    # HOVERING: mild forward inclination of the stroke plane (pitch 20 deg) with a
    # small down/up asymmetry from a 6 deg crank phase lag and a slightly longer t4
    # throw (25 vs 22 mm).
    disk { radius: 18.0 mm, crank_throw: 22 mm, tilt: 0.0 rad, pitch: 20 deg, kv: 1.0, ctrl: [-120, 120],
           solref: [0.02857142857142857, 1.0],
           outboard: 30.625 mm,
           foot_outset: 0.25 mm,
           disk_dx: 0 mm, disk_dy: -20 mm }
    drive M[1] and M[4]
    attach_along_edge = 0.0 rad
    attach_radius = 1.0
    crank_phase_lag = 6 deg
    crank_throw_t4 = 25 mm
    tendon_rest_length = 54.509 mm
    tendon_stiffness  = 1002.01 N/m
    tendon_damping    = 1.0
    control = control.tg
    motor_direction = 1

wing on M.midpoint:
    rod_length = 18.0 mm
    mount_arm  = 55.0 mm
    mesh       = wing.stl
    pitch:
        free_angle = 10 deg
        stiffness  = 0.05
        damping    = 1e-5
        initial    = 0.0 rad
        range      = [-0.7, 0.7] rad
        armature   = 1e-6
    aero:
        blades      = 4
        force_scale = 1e6
        body_torque = off
        cop         = derived
