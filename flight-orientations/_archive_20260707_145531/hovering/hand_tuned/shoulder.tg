name = bi-shoulder
bird = hummer

world:
    gravity    = [0, 0, -9.81]
    # Stable timestep scales as scale^1.5 (spring-mass freq ~1/scale^1.5 as rod
    # mass drops with scale^3). 0.50 ms holds at scale 1.0; at scale 0.4 that needs
    # 0.50 * 0.4^1.5 ~ 0.13 ms or the full-size wing's aero diverges the rig.
    timestep   = 0.13 ms
    integrator = Euler
    scale      = 0.4
    meshdir    = assets

archetype strut C:
    shape    = arc
    radius   = 48.23931363603964 mm
    stations = [5.8, 68.7, 111.3, 174.2] deg
    width    = 6.0 mm
    arc_rod  = { radius: 4.0 mm, mass: 10 g }
    rung_rod = { radius: 2.0 mm, mass: 5 g }
    symmetry sigma = reflect(stations: 1<->4, 2<->3 ; faces: A<->B)

strut F = C { role: fixed,  plane: YZ }
strut M = C { role: mobile, plane: XZ }

arrange M relative_to F:
    gap            = 30 mm
    angle          = 0 deg
    mobile_dx      = 5 mm
    inplane_offset = 4.649 mm

placement:
    mount_height   = 258 mm
    lateral_offset = 31 mm

tendons:
    # Hand-tuned for low peak motor torque: defaults 200 -> 150 N/m, plus the
    # M[1B]--F[1B] sigma-family (the two edges that carry the largest tension at
    # the mid-downstroke torque peak) softened to 60 N/m. CPU euler: peak torque
    # 227 -> 180 mNm, swing 204 -> 131 mNm, lift 386 -> 340 mN, tip amp -9%.
    defaults { stiffness: 150 N/m, damping: 0.5, pretension: 0.827, width: 0.75 mm }
    length = derived
    generators under sigma:
        M[1A] -- F[4B]
        M[1A] -- F[3B]
        M[1B] -- F[2B]
        M[1B] -- F[1B]
        M[2A] -- F[4B]
        M[2B] -- F[1B]

    overrides:
        M[4A] -- F[4A] { stiffness: 60 N/m }
        M[1B] -- F[1B] { stiffness: 60 N/m }

motors:
    # HOVERING: mild forward inclination of the stroke plane (pitch 20 deg) with a
    # small down/up asymmetry from a 12 deg crank phase lag and a slightly longer t4
    # throw (26 vs 23 mm).
    disk { radius: 18.0 mm, crank_throw: 23 mm, tilt: 0.0 rad, pitch: 20 deg, kv: 1.0, ctrl: [-120, 120],
           solref: [0.02857142857142857, 1.0],
           outboard: 30.625 mm,
           foot_outset: 0.25 mm,
           disk_dx: 0 mm, disk_dy: -20 mm }
    drive M[1] and M[4]
    attach_along_edge = 0.0 rad
    attach_radius = 1.0
    crank_phase_lag = 12 deg
    crank_throw_t4 = 26 mm
    tendon_rest_length = 53 mm
    tendon_stiffness  = 1000 N/m
    tendon_damping    = 1.0
    control = control.tg
    motor_direction = 1

wing on M.midpoint:
    rod_length = 18.0 mm
    mount_arm  = 55.0 mm
    mesh       = wing.stl
    pitch:
        free_angle = 20 deg   # 10 -> 20 deg: more passive feathering, small lift gain at equal torque
        stiffness  = 0.05
        damping    = 1e-5
        initial    = 0.0 rad
        range      = [-0.7, 0.7] rad
        armature   = 1e-6
    aero:
        blades      = 4
        force_scale = 1e6
        body_torque = off
        cop         = derived
