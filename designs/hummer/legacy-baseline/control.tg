bird = hummer
# fundamental_frequency is the phase/cycle reference for the plots, not the drive
# (a0 is the velocity command). With the phase-drift fix (shoulder.tg: 180 deg
# offset + kv 1.5) the disk settles at ~10.017 Hz under load, so the reference is
# set to the measured achieved frequency to keep phase-plot cycles overlaid.
harmonics = 5
fundamental_frequency = 10.017 Hz
a0 = 63
a_1 = 0
b_1 = 0
a_2 = 0
b_2 = 0
a_3 = 0
b_3 = 0
a_4 = 0
b_4 = 0
a_5 = 0
b_5 = 0
