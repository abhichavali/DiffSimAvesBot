# Ported from legacy `motor_speed = 28 rad/s` (Tensegrity-Playground main). The
# disk hinge is a velocity actuator, so eval_control's value IS the commanded
# motor speed (rad/s): a constant a0 with zero harmonics = the old constant-speed
# drive. fundamental_frequency = a0 / (2*pi) = 28 / 6.28319 = 4.4563 Hz (one crank
# rev per flap cycle), used for phase/cycle normalization in the plots.
harmonics = 1
fundamental_frequency = 4.4563 Hz
a0 = 28
a_1 = 0
b_1 = 0
